# rvh reads its API key from the environment. Keep it in your shell
# profile or a file you `source` — not in this repository.
export RVH_API_KEY=""

# Optional: joern JVM heap in GB for large (e.g. C++) code property graphs.
# Keep it within the memory your container runtime is allotted.
# export RVH_CPG_HEAP_GB=16
